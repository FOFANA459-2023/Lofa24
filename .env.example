# Optional. Formspree form ID (the part after /f/ in your endpoint URL).
# When set, the contact form posts to Formspree. When unset, the contact page
# shows a direct-contact panel instead of a form that goes nowhere.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional. Shown on the contact page when the form is not connected.
NEXT_PUBLIC_CONTACT_EMAIL=
